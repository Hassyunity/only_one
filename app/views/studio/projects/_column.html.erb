<div id="studio-column-<%= column[:id] %>"
     data-action="dragover->kanban#dragOver drop->kanban#drop"
     data-kanban-stage-param="<%= column[:id] %>"
     style="min-width:270px;width:270px;flex:none;display:flex;flex-direction:column;gap:var(--space-3);background:var(--color-surface);padding:var(--space-3);">
  <div style="display:flex;justify-content:space-between;align-items:baseline;">
    <div style="font-family:var(--font-heading);font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.04em;"><%= column[:label] %></div>
    <span class="tag tag-neutral"><%= column[:count] %></span>
  </div>
  <div style="display:flex;flex-direction:column;gap:var(--space-2);min-height:40px;">
    <%= render partial: "studio/projects/card", collection: column[:items], as: :project %>
  </div>
</div>
