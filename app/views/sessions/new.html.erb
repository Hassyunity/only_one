<% content_for :title, "Connexion — #{company_name}" %>

<div style="min-height:100vh;display:flex;flex-wrap:wrap;">
  <div style="flex:1 1 420px;display:flex;flex-direction:column;justify-content:center;padding:var(--space-8);gap:var(--space-8);">
    <div style="font-family:var(--font-heading);font-weight:800;font-size:16px;display:flex;align-items:center;gap:var(--space-2);">
      <span style="width:28px;height:28px;border-radius:var(--radius-pill);background:linear-gradient(135deg, var(--color-accent), var(--color-accent-2));display:inline-block;"></span>
      <%= company_name %>
    </div>

    <div style="max-width:360px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:var(--space-4);">
      <div>
        <h1 style="font-size:28px;margin:0 0 4px;">Connexion</h1>
        <p class="text-muted" style="margin:0;">Connectez-vous pour accéder à votre espace de travail.</p>
      </div>

      <% if flash[:alert] %>
        <p style="color:var(--color-accent-700);font-size:13px;margin:0;background:var(--color-accent-100);padding:8px 12px;border-radius:var(--radius-md);"><%= flash[:alert] %></p>
      <% end %>

      <%= form_with url: session_path, method: :post, style: "display:flex;flex-direction:column;gap:var(--space-3);" do |f| %>
        <div class="field">
          <label>Email</label>
          <%= f.email_field :email, class: "input", required: true, autofocus: true, placeholder: "votre@email.fr" %>
        </div>
        <div class="field">
          <label>Mot de passe</label>
          <%= f.password_field :password, class: "input", required: true, placeholder: "••••••••" %>
        </div>
        <%= f.submit "Se connecter", class: "btn btn-primary btn-block", style: "justify-content:center;margin-top:var(--space-2);" %>
      <% end %>

      <p class="text-muted" style="text-align:center;font-size:13px;margin:0;">Pas encore de compte ? Contactez votre administrateur.</p>
    </div>
  </div>

  <div style="flex:1 1 420px;position:relative;overflow:hidden;background:var(--color-dark);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--space-8);padding:var(--space-8);min-height:420px;">
    <div aria-hidden="true" style="position:absolute;inset:0;overflow:hidden;pointer-events:none;">
      <div style="position:absolute;top:40px;right:60px;width:70px;height:70px;border:1px solid color-mix(in srgb, var(--color-text-inverse) 12%, transparent);border-radius:16px;transform:rotate(12deg);"></div>
      <div style="position:absolute;top:120px;right:150px;width:40px;height:40px;background:color-mix(in srgb, var(--color-text-inverse) 6%, transparent);border-radius:10px;transform:rotate(-8deg);"></div>
      <div style="position:absolute;bottom:60px;left:40px;width:90px;height:90px;border:1px solid color-mix(in srgb, var(--color-text-inverse) 10%, transparent);border-radius:20px;transform:rotate(20deg);"></div>
      <div style="position:absolute;bottom:170px;left:130px;width:34px;height:34px;background:color-mix(in srgb, var(--color-text-inverse) 6%, transparent);border-radius:8px;"></div>
    </div>

    <div style="position:relative;display:flex;gap:var(--space-4);align-items:flex-end;">
      <div class="card" style="width:230px;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <span class="card-title" style="font-size:14px;">Aperçu</span>
          <div style="display:flex;gap:4px;">
            <span class="tag tag-neutral">Sem.</span>
            <span class="tag tag-outline">Mois</span>
          </div>
        </div>
        <svg viewBox="0 0 200 60" style="width:100%;height:60px;margin-top:8px;" preserveAspectRatio="none">
          <polyline points="0,45 30,25 60,35 90,10 120,30 150,15 180,25 200,18" fill="none" stroke="var(--color-accent-2)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="card hero-card-center" style="width:130px;padding:var(--space-4);">
        <div class="progress-ring on-light" style="--pct:72;max-width:90px;">
          <div class="progress-ring-hole">
            <div class="progress-ring-pct" style="font-size:17px;">72%</div>
          </div>
        </div>
      </div>
    </div>

    <div style="position:relative;text-align:center;color:var(--color-text-inverse);max-width:340px;">
      <h3 style="color:var(--color-text-inverse);margin:0 0 6px;">Une plateforme unique pour piloter votre activité</h3>
      <p style="opacity:.65;font-size:13px;margin:0;">CRM, RH, studio créatif et développement réunis dans un seul espace de travail.</p>
    </div>
  </div>
</div>
