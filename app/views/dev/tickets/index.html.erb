<% content_for :title, "Développeurs — #{company_name}" %>

<%= render "shared/hero",
      kicker: "Technique",
      title: "Développeurs",
      subtitle: @summary,
      meta_pills: @hero_meta_pills,
      ring_pct: @completion_rate,
      ring_label: "Sprint terminé",
      ring_sub: "#{DevTicket.termine.count}/#{DevTicket.count} tickets",
      icon: :dev %>

<div style="padding:var(--space-6);display:flex;flex-direction:column;gap:var(--space-4);">
  <div data-controller="kanban"
       data-kanban-move-url-template-value="<%= move_dev_ticket_path(id: "__ID__") %>"
       data-kanban-filter-value=""
       style="display:flex;gap:var(--space-4);overflow-x:auto;padding-bottom:var(--space-3);">
    <% @columns.each do |column| %>
      <%= render "column", column: column %>
    <% end %>
  </div>
</div>
