<div class="hero">
  <div class="hero-meta">
    <% meta_pills.each do |pill| %>
      <span class="hero-pill"><%= pill %></span>
    <% end %>
    <% if local_assigns[:primary_action] || local_assigns[:secondary_action] %>
      <div class="hero-actions">
        <% if local_assigns[:secondary_action] %>
          <%= link_to secondary_action[:label], secondary_action[:url], class: "btn btn-secondary" %>
        <% end %>
        <% if local_assigns[:primary_action] %>
          <%= link_to primary_action[:label], primary_action[:url], class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="hero-row">
    <div class="hero-card">
      <div class="hero-card-kicker"><%= kicker %></div>
      <h2><%= title %></h2>
      <p><%= subtitle %></p>
    </div>

    <div class="hero-card hero-card-center">
      <div class="progress-ring" style="--pct: <%= ring_pct %>;">
        <div class="progress-ring-hole">
          <div class="progress-ring-pct"><%= ring_pct %>%</div>
          <div class="progress-ring-label"><%= ring_label %></div>
        </div>
      </div>
      <div class="progress-ring-sub"><%= ring_sub %></div>
    </div>

    <div class="hero-decorative"><%= hero_icon(icon) %></div>
  </div>
</div>
